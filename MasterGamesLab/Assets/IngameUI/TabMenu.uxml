<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="RowTemplate" src="project://database/Assets/IngameUI/tabmenutemplates/RowTemplate.uxml?fileID=9197481963319205126&amp;guid=80ac94e3d95f55c45bc6e55e8298e8b1&amp;type=3#RowTemplate"/>
    <Style src="project://database/Assets/Lobby/Theme.uss?fileID=7433441132597879392&amp;guid=a88bc4db9de616e479d723516556bada&amp;type=3#Theme"/>
    <ui:VisualElement name="root" class="unity-ui-document__root" style="width: 100%; height: 100%; flex-direction: column;">
        <ui:VisualElement name="header-row" style="width: 100%; height: 20%; flex-direction: row;">
            <ResponsiveButton class="element tab-menu-header" style="width: 25%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%;"/>
            <ResponsiveButton name="ResponsiveButton" class="element tab-menu-header" style="width: 15%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%;">
                <ui:VisualElement class="element tab-menu-header" style="width: 60%; padding-right: 6.67%; padding-left: 6.67%;">
                    <ui:VisualElement name="VisualElement" class="element tab-menu-header-icon"/>
                </ui:VisualElement>
            </ResponsiveButton>
            <ResponsiveButton name="ResponsiveButton" class="element tab-menu-header" style="width: 15%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%;">
                <ui:VisualElement class="element tab-menu-header" style="width: 60%; padding-right: 6.67%; padding-left: 6.67%;">
                    <ui:VisualElement name="VisualElement" class="element tab-menu-header-icon"/>
                </ui:VisualElement>
            </ResponsiveButton>
            <ResponsiveButton name="ResponsiveButton" class="element tab-menu-header">
                <ui:VisualElement name="VisualElement" class="element tab-menu-header-icon"/>
            </ResponsiveButton>
            <ResponsiveButton name="ResponsiveButton" class="element tab-menu-header">
                <ui:VisualElement name="VisualElement" class="element tab-menu-header-icon"/>
            </ResponsiveButton>
            <ResponsiveButton name="ResponsiveButton" class="element tab-menu-header">
                <ui:VisualElement name="VisualElement" class="element tab-menu-header-icon"/>
            </ResponsiveButton>
            <ResponsiveButton name="ResponsiveButton" class="element tab-menu-header">
                <ui:VisualElement name="VisualElement" class="element tab-menu-header-icon"/>
            </ResponsiveButton>
            <ResponsiveButton name="ResponsiveButton" class="element tab-menu-header">
                <ui:VisualElement name="VisualElement" class="element tab-menu-header-icon"/>
            </ResponsiveButton>
        </ui:VisualElement>
        <ui:VisualElement name="players-container" style="width: 100%; height: 80%; flex-direction: column;">
            <ui:Instance template="RowTemplate" style="width: 100%; height: 25%;"/>
            <ui:Instance template="RowTemplate" style="width: 100%; height: 25%;"/>
            <ui:Instance template="RowTemplate" style="width: 100%; height: 25%;"/>
            <ui:Instance template="RowTemplate" style="width: 100%; height: 25%;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
