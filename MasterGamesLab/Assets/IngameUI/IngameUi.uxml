<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Lobby/Theme.uss?fileID=7433441132597879392&amp;guid=a88bc4db9de616e479d723516556bada&amp;type=3#Theme"/>
    <ui:VisualElement name="Root" class="unity-ui-document__root">
        <ResponsiveLabel name="MONEY" text="Money: 100" class="element label money-display"/>
        <ui:GroupBox name="Row1" class="element ingam-build-menu-row"/>
        <ui:GroupBox name="BuildMenu" class="element build-menu-sidebar" style="justify-content: flex-end; height: auto; position: absolute; right: 1%; bottom: 2%; left: auto; top: auto;">
            <ShrinkWrapContainer name="ShrinkWrapContainer" style="background-color: rgba(0, 0, 0, 0.77);">
                <ui:GroupBox name="" class="element group-box-top" style="align-items: flex-end; flex-direction: row; align-self: flex-end; flex-grow: 1;">
                    <ui:VisualElement class="element ingame-construct-button-square"/>
                    <ui:VisualElement class="element ingame-construct-button-square">
                        <ui:Button text="" name="BuyFreighterButton" class="button element ingame-build-button">
                            <ui:VisualElement name="Icon" class="ingame-build-button-icon element"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="element ingame-construct-button-square">
                        <ui:Button text="" name="BuyTruckButton" class="button element ingame-build-button">
                            <ui:VisualElement name="Icon" class="ingame-build-button-icon element"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="element ingame-construct-button-square">
                        <ui:Button text="" name="BuildRoadButton" class="button element ingame-build-button">
                            <ui:VisualElement name="Icon" class="ingame-build-button-icon element"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="element ingame-construct-button-square">
                        <ui:Button text="" name="BuildPortButton" class="button element ingame-build-button">
                            <ui:VisualElement name="Icon" class="ingame-build-button-icon element"/>
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:VisualElement class="element ingame-construct-button-square">
                        <ui:Button text="" name="BuildCanalButton" class="button element ingame-build-button">
                            <ui:VisualElement name="Icon" class="ingame-build-button-icon element"/>
                        </ui:Button>
                    </ui:VisualElement>
                </ui:GroupBox>
                <ui:GroupBox name="" class="element group-box-divider">
                    <ui:VisualElement name="VisualElement" class="element div build-menu-divider-line"/>
                </ui:GroupBox>
                <ui:GroupBox class="element group-box-bottom" style="align-items: stretch; flex-grow: 0;">
                    <ui:VisualElement class="element ingame-build-button-square">
                        <ResponsiveButton text="" name="ConfirmButton" class="element button ingame-build-button confirm-btn"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="element ingame-build-button-square">
                        <ResponsiveButton text="" name="CancelButton" class="element button ingame-build-button cancel-btn"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="element ingame-build-button-square">
                        <ui:Button text="hide" name="HideButton" class="element button ingame-build-button"/>
                    </ui:VisualElement>
                </ui:GroupBox>
            </ShrinkWrapContainer>
        </ui:GroupBox>
    </ui:VisualElement>
</ui:UXML>
