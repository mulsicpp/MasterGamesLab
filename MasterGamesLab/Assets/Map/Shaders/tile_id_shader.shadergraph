{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "492eab3156134861b62294180eb89ad5",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "id_to_color (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -587.9999389648438,
            "y": 101.0,
            "width": 216.0,
            "height": 94.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "925cc5dcadb04ce4888bf48f6e2629c2"
        },
        {
            "m_Id": "520fd0f24b2d4d99b8a2e0bf3a289c4c"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 1,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "id_to_color",
    "m_FunctionSource": "c3be6cc50c2b2d642a77e0943ddeccc1",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "uint id = asuint(IdBits);\r\n\r\n// Shift the bits to extract 3 bytes (R, G, B) and normalize to 0.0 - 1.0\r\nfloat r = (float)((id >> 16) & 0xFF) / 255.0;\r\nfloat g = (float)((id >> 8) & 0xFF) / 255.0;\r\nfloat b = (float)(id & 0xFF) / 255.0;\r\n\r\nIdColor = float3(r, g, b);"
}

