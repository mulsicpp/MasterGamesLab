<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="root" style="flex-grow: 1; align-content: auto; justify-content: center; background-color: rgb(0, 0, 0);">
        <ui:VisualElement style="flex-grow: 0; height: 17%; flex-shrink: 0; align-content: auto; justify-content: center; align-items: center; flex-direction: row;">
            <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; width: 37px;"/>
            <ui:Button text="Host" name="Host" style="height: 100%; width: 40%;"/>
            <ui:Button text="Join" name="Join" style="height: 100%; width: 40%;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
