.unity-ui-document__root {
    --text-font: url("project://database/Assets/Fonts/Bahnschrift-Condensed.ttf?fileID=12800000&guid=5ecfafd68e5d69944bac0bbd8593c196&type=3#Bahnschrift-Condensed");
    --text-color: rgb(255, 255, 255);
    --background-button-color: rgba(255, 255, 255, 0.05);
    --hover-background-button-color: rgb(255, 255, 255);
    --border-radius: 0;
    --outline-color: rgb(255, 255, 255);
    --outline-width: 1px;
    --text-outline-color: rgb(0, 0, 0);
    --text-outline-width: 1px;
    --border-color: var(--outline-color);
    --border-width: var(--outline-width);
    --disabled-border-color: rgba(255, 254, 254, 0.2);
    --disabled-background-color: rgba(0, 0, 0, 0);
    --white-space: nowrap;
    --overflow: hidden;
    --text-overflow: ellipsis;
    --copy-hovered: rgba(255, 255, 255, 0.16);
    --error-color: rgb(255, 73, 73);
}

.element {
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
}

.devider {
    background-color: var(--hover-background-button-color);
}

.label {
    color: var(--text-color);
    -unity-font-definition: var(--text-font);
    -unity-text-align: middle-left;
    white-space: var(--white-space);
    overflow: var(--overflow);
    text-overflow: var(--text-overflow);
}

.button {
    color: var(--text-color);
    -unity-font-definition: var(--text-font);
    background-color: var(--background-button-color);
    border-color: var(--border-color);
    border-width: var(--border-width);
    border-radius: var(--border-radius);
    -unity-text-align: middle-center;
    white-space: var(--white-space);
    overflow: var(--overflow);
    text-overflow: var(--text-overflow);
}

.button:hover {
    background-color: var(--hover-background-button-color);
    color: var(--text-color);
    -unity-text-outline-width: var(--text-outline-width);
    -unity-text-outline-color: var(--text-outline-color);
}

.button:disabled {
    color: var(--disabled-border-color);
    background-color: var(--disabled-background-color);
    border-color: var(--disabled-border-color);
    -unity-text-outline-width: 0;
}

.text-field {
    color: var(--text-color);
    background-color: var(--background-button-color);
    border-color: var(--border-color);
    border-width: var(--border-width);
    border-radius: var(--border-radius);
    -unity-font-definition: var(--text-font);
    -unity-text-align: middle-left;
    white-space: var(--white-space);
    overflow: var(--overflow);
    text-overflow: var(--text-overflow);
}

.text-field #unity-text-input {
    --unity-cursor-color: var(--text-color);
}

#ListView .unity-list-view__item {
    height: 50%;
}

.unity-list-view__item:hover {
    background-color: rgba(0, 0, 0, 0);
}

.unity-slider {
    margin: 0;
    min-width: 0;
    width: 100%;
    translate: 200%, 0;
}

.unity-scroller {
    width: 1%;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 1px;
    border-color: rgba(0, 0, 0, 0);
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}

#unity-tracker,
#unity-tracker:hover,
#unity-tracker:active {
    border-radius: 6px;
    border-width: 0;
    background-color: var(--background-button-color);
}

#unity-dragger {
    background-color: rgba(255, 255, 255, 0.36);
    border-radius: 6px;
    border-width: 0;
    min-height: 20px;
    left: 0;
    width: 100%;
}

#unity-dragger:hover,
#unity-dragger:active,
#unity-dragger:focus,
.unity-base-slider__input:active #unity-dragger,
.unity-slider__input:active #unity-dragger,
#unity-drag-container:active #unity-dragger {
    background-color: var(--hover-background-button-color);
}

.lobby-player-div {
    height: 4.4%;
    width: 100%;
}

.lobby-player-label {
    height: 20.56%;
    width: 100%;
    background-color: var(--background-button-color);
    border-color: var(--border-color);
    border-width: var(--border-width);
    border-radius: var(--border-radius);
    -unity-font-definition: var(--text-font);
    padding-right: 0;
    padding-left: 2%;
    justify-content: center;
    align-items: flex-end;
}

.lobby-player-label-empty {
    height: 20.56%;
    width: 100%;
    background-color: var(--disabled-background-color);
    border-color: var(--disabled-border-color);
    border-width: var(--border-width);
    border-radius: var(--border-radius);
    -unity-font-definition: var(--text-font);
    padding-right: 0;
    padding-left: 2%;
    align-items: flex-end;
}

.host-crown {
    height: 100%;
    background-image: url("project://database/Assets/Lobby/Crown.svg?fileID=7388822144124034973&guid=5771e13031fb0b546824e0b0c877c56e&type=3#Crown");
    -unity-background-image-tint-color: var(--background-button-color);
    margin-right: 2%;
}

.copy-button {
    color: var(--text-color);
    -unity-font-definition: var(--text-font);
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--border-color);
    border-radius: var(--border-radius);
    -unity-text-align: middle-left;
}

.copy-button:hover {
    color: var(--background-button-color);
}

.copy-button:disabled {
    color: var(--disabled-border-color);
    background-color: var(--disabled-background-color);
    border-color: var(--disabled-border-color);
    -unity-text-outline-width: 0;
}

.copy-button:hover > .image-icon {
    -unity-background-image-tint-color: var(--copy-hovered);
}

.copy-button:hover > .text-label {
    color: var(--copy-hovered);
}

.name-text-field {
    width: 100%;
    height: 29.8%;
    background-color: var(--background-button-color);
    box-shadow-color: rgba(255, 218, 0, 0);
    box-shadow-blur: 0;
    box-shadow-offset: 0 0;
    transition-property: border-color, border-width, box-shadow-color, box-shadow-blur, scale, background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.highlighted-text-field {
    border-color: var(--error-color);
    border-width: 2px;
    color: var(--error-color);
    background-color: rgba(0, 0, 0, 0.4);
    scale: 1.02 1.02;
}

.ingame-build-button {
    width: 100%;
    height: 100%;
}

.ingame-build-button--active {
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
}

.ingame-build-button-parent {
    width: auto;
    flex-shrink: 0;
    height: 7%;
    margin-bottom: 19%;
}
