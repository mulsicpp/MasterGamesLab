<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="root" style="flex-grow: 0; background-color: rgb(0, 0, 0); justify-content: center; width: 100%; height: 100%; flex-shrink: 0;">
        <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; height: 39%; width: 100%;">
            <ui:TextField label="Name" placeholder-text="Enter your name" name="Name" style="background-color: rgb(178, 178, 178);"/>
            <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
                <ui:Label text="IP Address:" name="Label" style="background-color: rgb(178, 178, 178); width: 12%;"/>
                <ui:Label text="192.168.1.1" name="IpAddress" style="background-color: rgb(178, 178, 178); width: 86%;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: center;">
                <ui:Button text="Back" name="Back" style="width: 42%;"/>
                <ui:Button text="Host" name="Host" style="width: 42%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
