<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="root" style="flex-grow: 0; background-color: rgb(0, 0, 0); justify-content: center; width: 100%; height: 100%; flex-shrink: 0;">
        <ui:Label text="NickNocks Lobby" name="LobbyNameLabel" style="background-color: rgb(255, 255, 255); -unity-text-align: upper-center;"/>
        <ui:Label text="Player1" name="Player0Label" style="background-color: rgb(255, 255, 255);"/>
        <ui:Label text="Player4" name="Player1Label" style="background-color: rgb(255, 255, 255);"/>
        <ui:Label text="Player2" name="Player2Label" style="background-color: rgb(255, 255, 255);"/>
        <ui:Label text="Player3" name="Player3Label" style="background-color: rgb(255, 255, 255);"/>
        <ui:VisualElement style="flex-grow: 0; flex-shrink: 0; height: 39%; width: 100%;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; justify-content: center;">
                <ui:Button text="Back" name="BackButton" style="width: 42%;"/>
                <ui:Button text="Start" name="StartButton" style="width: 42%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label text="Code: FK5G " name="CodeLabel" style="background-color: rgb(255, 255, 255);"/>
    </ui:VisualElement>
</ui:UXML>
